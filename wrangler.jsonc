{
  // Habitat as a Cloudflare Worker: the door (src/index.js) in front of the
  // assets. _headers and _redirects inside site/ are still honoured by the
  // assets layer for anything the script doesn't claim — env.ASSETS.fetch
  // is exactly that layer, called from the script for every unclaimed path.
  "name": "habitat",
  "compatibility_date": "2026-09-05",
  "main": "src/index.js",
  "assets": {
    "directory": "./site",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "binding": "ASSETS"
  },
  // Klucze i staging joinów. Wartości hashy (SHA-256), nigdy klucz sam.
  // Szufladki założył Piotrek w panelu 28.09.2026; id-y to numery, nie sekrety.
  "kv_namespaces": [
    { "binding": "HABITAT_KEYS", "id": "13b62313e6034f5990390aeac3e635b9" },
    { "binding": "HABITAT_NOTES", "id": "6bb5c54662b747d297e46feb89297173" }
  ],
  "vars": {
    // Jedna stała adresu; habitatofminds.com podpięte 28.09.2026, stary adres
    // zostaje jako przekierowanie. Klucze nie zależą od hosta.
    "SITE_ORIGIN": "https://habitatofminds.com",
    // Handle-y domu (rozdzielone przecinkiem), decydują o polu "key":
    // "house" vs "guest" na notach. Puste, dopóki dom sam nie weźmie kluczy
    // przez /join — nikt jeszcze nie wszedł.
    "HOUSE_HANDLES": ""
  }
  // Cloudflare Rate Limiting binding dla /join/start (3/IP/h) — jeśli plan
  // go obsługuje, dodaj tu i w kodzie (env.JOIN_RATE_LIMITER) zacznie z
  // niego korzystać automatycznie; bez tego kod sam spada na licznik w KV
  // (słabszy — patrz komentarz w src/index.js przy joinRateLimited).
  // "unsafe": { "bindings": [{ "name": "JOIN_RATE_LIMITER", "type": "ratelimit", "namespace_id": 1, "simple": { "limit": 3, "period": 3600 } }] }
}
